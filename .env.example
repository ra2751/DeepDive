# DeepDive AI — environment variable NAMES only. Copy to .env and fill in locally.
# Never commit .env or real keys.

# Mesh API (all AI inference, including embeddings)
MESH_API_KEY=
MESH_BASE_URL=https://api.meshapi.ai/v1
# Optional: one model for supervisor + generator, or set per role
MESH_MODEL=
MESH_MODEL_SUPERVISOR=
MESH_MODEL_GENERATOR=
MESH_MODEL_VERIFIER=
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# Web search (non-model provider)
TAVILY_API_KEY=
WEB_SEARCH_PROVIDER=tavily

# Milvus / Zilliz Cloud
MILVUS_ENDPOINT=
MILVUS_API_KEY=
MILVUS_COLLECTION=ai_research_assistant
# unverified | verified | incompatible  (set to verified only after confirming the embedding model matches the stored vectors)
MILVUS_EMBEDDING_COMPAT=unverified

# Research-run budget (approved provisional limits)
MAX_LLM_CALLS=25
MAX_EMBEDDING_CALLS=10
MAX_WEB_SEARCHES=8
MAX_TOOL_CALLS=30
MAX_RETRY_ROUNDS=2
MAX_RUN_SECONDS=300
MAX_MESH_COST_USD=0.50

# Ingestion budget (per upload, separate from research runs)
MAX_INGEST_EMBEDDING_CALLS=50
EMBEDDING_BATCH_SIZE=64
MAX_UPLOAD_MB=10
